{
  "Id": "7487f0be-1afd-49a8-b257-c41459c5afa9",
  "TriggerKeywords": ["ql"],
  "Name": "Quick Links",
  "Description": "Quickly open named URLs in your browser",
  "Author": "bonemind",
  "Version": "0.0.2",
  "MinWoxVersion": "2.0.0",
  "Runtime": "nodejs",
  "Website": "https://github.com/Bonemind/Wox.Plugin.QuickLinks",
  "Entry": "index.js",
  "Icon": "relative:images/icon.svg",
  "SupportedOS": ["Windows", "Linux", "Darwin"],
  "I18n": {
    "en_US": {
      "pinyin_search_label": "Pinyin search",
      "pinyin_search_tooltip": "Match full pinyin and initials. Changes apply immediately."
    },
    "zh_CN": {
      "pinyin_search_label": "拼音检索",
      "pinyin_search_tooltip": "支持全拼和首字母，修改后立即生效。"
    },
    "zh_TW": {
      "pinyin_search_label": "拼音检索",
      "pinyin_search_tooltip": "支持全拼和首字母，修改后立即生效。"
    },
    "zh_HK": {
      "pinyin_search_label": "拼音检索",
      "pinyin_search_tooltip": "支持全拼和首字母，修改后立即生效。"
    },
    "zh_MO": {
      "pinyin_search_label": "拼音检索",
      "pinyin_search_tooltip": "支持全拼和首字母，修改后立即生效。"
    },
    "zh_SG": {
      "pinyin_search_label": "拼音检索",
      "pinyin_search_tooltip": "支持全拼和首字母，修改后立即生效。"
    }
  },
  "Commands": [
    {
      "Command": "add",
      "Description": "Add a new quick link: add <name> <url>"
    }
  ],
  "Features": [
    {
      "Name": "mru",
      "Params": {
        "HashBy": "title"
      }
    }
  ],
  "SettingDefinitions": [
    {
      "Type": "checkbox",
      "Value": {
        "Key": "enablePinyin",
        "DefaultValue": "true",
        "Label": "i18n:pinyin_search_label",
        "Tooltip": "i18n:pinyin_search_tooltip"
      }
    },
    {
      "Type": "table",
      "Value": {
        "Key": "links",
        "DefaultValue": "[]",
        "Title": "Quick Links",
        "Tooltip": "Add named URLs to open quickly",
        "SortColumnKey": "name",
        "SortOrder": "asc",
        "MaxHeight": 500,
        "Columns": [
          {
            "Key": "name",
            "Label": "Name",
            "Type": "text",
            "Width": 150,
            "Validators": [
              {
                "Type": "not_empty",
                "Value": {}
              }
            ]
          },
          {
            "Key": "url",
            "Label": "URL",
            "Type": "text",
            "Width": 350,
            "Validators": [
              {
                "Type": "not_empty",
                "Value": {}
              }
            ]
          }
        ]
      }
    }
  ]
}
