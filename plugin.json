{
  "Id": "7487f0be-1afd-49a8-b257-c41459c5afa9",
  "TriggerKeywords": ["ql"],
  "Name": "Quick Links",
  "Description": "Quickly open named URLs in your browser",
  "Author": "bonemind",
  "Version": "0.0.2",
  "MinWoxVersion": "2.0.0",
  "Runtime": "nodejs",
  "Website": "https://github.com/FallingMY/Wox.Plugin.QuickLinks",
  "Entry": "index.js",
  "Icon": "relative:images/icon.svg",
  "SupportedOS": ["Windows", "Linux", "Darwin"],
  "Commands": [
    {
      "Command": "add",
      "Description": "Add a new quick link: add <name> <url>"
    }
  ],
  "Features": [
    {
      "Name": "mru",
      "Params": {
        "HashBy": "title"
      }
    }
  ],
  "SettingDefinitions": [
    {
      "Type": "checkbox",
      "Value": {
        "Key": "enablePinyin",
        "DefaultValue": "true",
        "Label": "Enable pinyin search / 启用拼音检索",
        "Tooltip": "Match Chinese link names using pinyin and initials. Independent of Wox's global pinyin setting; changes apply immediately. / 使用拼音和首字母检索中文链接名称，独立于 Wox 全局拼音设置，修改后立即生效。"
      }
    },
    {
      "Type": "table",
      "Value": {
        "Key": "links",
        "DefaultValue": "[]",
        "Title": "Quick Links",
        "Tooltip": "Add named URLs to open quickly",
        "SortColumnKey": "name",
        "SortOrder": "asc",
        "MaxHeight": 500,
        "Columns": [
          {
            "Key": "name",
            "Label": "Name",
            "Type": "text",
            "Width": 150,
            "Validators": [
              {
                "Type": "not_empty",
                "Value": {}
              }
            ]
          },
          {
            "Key": "url",
            "Label": "URL",
            "Type": "text",
            "Width": 350,
            "Validators": [
              {
                "Type": "not_empty",
                "Value": {}
              }
            ]
          }
        ]
      }
    }
  ]
}
